# Copy this file to the repository-root .env before running Docker Compose.
# The root .env is ignored by Git. Replace every required example value; do not commit real secrets.

COMPOSE_PROJECT_NAME=haru-dev
TZ=Asia/Seoul

# Required local-only secrets. Use different, random values outside a throwaway development stack.
MYSQL_ROOT_PASSWORD=replace-with-a-random-local-database-password
REDIS_PASSWORD=replace-with-a-random-local-redis-password
JWT_SECRET=replace-with-a-random-value-at-least-32-bytes-long

MYSQL_DATABASE=haru_db
JWT_EXPIRATION=86400000
GATEWAY_PORT=8080
FRONTEND_PORT=3000
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth2/redirect

# Optional FastAPI profile (`docker compose --profile ai up`).
LLAMA_MODEL_DIR=./FastAPI/models
LLAMA_MODEL_FILE=tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf
LLAMA_N_CTX=2048
LLAMA_N_GPU_LAYERS=0

# Optional frontend profile (`docker compose --profile ui up`). Values are embedded at image build time.
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080/ws

# Optional external integrations. Leave blank for infrastructure-only development.
SMS_API_KEY=
SMS_API_SECRET=
SMS_API_URL=
NAVER_CLOUD_CHATBOT_SECRET_KEY=
NAVER_CLOUD_CHATBOT_API_URL=
NAVER_CLOUD_OCR_SECRET_KEY=
NAVER_CLOUD_OCR_API_URL=
KAKAO_REST_API_KEY=
