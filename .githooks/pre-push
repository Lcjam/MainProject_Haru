#!/usr/bin/env bash
# 푸시 전 게이트: 정책 + 바뀐 모듈 check + diff 커버리지. CI와 같은 규칙이다.
# main 직접 푸시는 막는다(브랜치 보호와 동일). 원격 기준은 origin/main.
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "✗ main에 직접 푸시하지 않는다. 브랜치 → PR → CI 통과 후 머지."
    exit 1
  fi
done
git fetch -q origin main 2>/dev/null || true
exec "$(git rev-parse --show-toplevel)/scripts/gate/gate.sh" push origin/main
