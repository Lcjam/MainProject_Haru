{
  "version": 1,
  "description": "Haru 공유 오류 계약(C01). Gateway·Core·Assist의 모든 JSON 오류 응답과 프론트 해석의 단일 기준. 서비스 테스트와 프론트 테스트가 이 파일을 함께 읽는다.",
  "envelope": {
    "status": "error",
    "required": ["status", "code", "message"],
    "rules": [
      "오류는 HTTP 4xx/5xx로 보낸다. HTTP 200 본문에 status=error를 담는 것은 레거시이며 새 코드에서 금지한다.",
      "code는 아래 codes 목록의 대문자 기계 코드다. 숫자 문자열(\"400\" 등)은 레거시이며 응답 직전에 대응 코드로 정규화한다.",
      "message는 사용자에게 그대로 보여도 되는 한국어 문구다. 예외 메시지·스택·SQL·외부 제공자 응답을 넣지 않는다.",
      "data는 오류에서 선택이다. 레거시 호환으로 message와 같은 문자열이 올 수 있으나 클라이언트는 message만 읽는다.",
      "클라이언트 분기는 HTTP 상태와 code로만 한다. message 문자열 비교로 분기하지 않는다."
    ]
  },
  "codes": {
    "BAD_REQUEST": { "http": 400, "message": "잘못된 요청입니다.", "fixedMessage": false },
    "INVALID_PATH": { "http": 400, "message": "잘못된 요청 경로입니다.", "fixedMessage": true },
    "AUTH_REQUIRED": { "http": 401, "message": "로그인이 필요합니다.", "fixedMessage": false, "clientAction": "login" },
    "AUTH_EXPIRED": { "http": 401, "message": "인증이 만료되었습니다.", "fixedMessage": true, "clientAction": "relogin" },
    "AUTH_INVALID": { "http": 401, "message": "유효하지 않은 인증입니다.", "fixedMessage": false, "clientAction": "relogin" },
    "FORBIDDEN": { "http": 403, "message": "접근 권한이 없습니다.", "fixedMessage": false },
    "NOT_FOUND": { "http": 404, "message": "요청한 자원을 찾을 수 없습니다.", "fixedMessage": false },
    "METHOD_NOT_ALLOWED": { "http": 405, "message": "허용되지 않은 요청 방식입니다.", "fixedMessage": true },
    "CONFLICT": { "http": 409, "message": "요청이 현재 상태와 충돌합니다.", "fixedMessage": false },
    "DUPLICATE_EMAIL": { "http": 409, "message": "이미 사용 중인 이메일입니다.", "fixedMessage": false },
    "DUPLICATE_NICKNAME": { "http": 409, "message": "이미 사용 중인 닉네임입니다.", "fixedMessage": false },
    "DUPLICATE_PHONE": { "http": 409, "message": "이미 등록된 전화번호입니다.", "fixedMessage": false },
    "PAYLOAD_TOO_LARGE": { "http": 413, "message": "요청 크기가 너무 큽니다.", "fixedMessage": true },
    "UNSUPPORTED_MEDIA_TYPE": { "http": 415, "message": "지원하지 않는 요청 형식입니다.", "fixedMessage": true },
    "TOO_MANY_REQUESTS": { "http": 429, "message": "요청이 너무 많습니다. 잠시 후 다시 시도해주세요.", "fixedMessage": true },
    "INTERNAL_ERROR": { "http": 500, "message": "서버 오류가 발생했습니다.", "fixedMessage": true },
    "UPSTREAM_UNAVAILABLE": { "http": 503, "message": "서비스에 일시적으로 연결할 수 없습니다.", "fixedMessage": true },
    "UPSTREAM_TIMEOUT": { "http": 504, "message": "서비스 응답이 지연되고 있습니다.", "fixedMessage": true }
  },
  "legacyNumericCodes": {
    "400": "BAD_REQUEST",
    "401": "AUTH_REQUIRED",
    "403": "FORBIDDEN",
    "404": "NOT_FOUND",
    "405": "METHOD_NOT_ALLOWED",
    "409": "CONFLICT",
    "413": "PAYLOAD_TOO_LARGE",
    "415": "UNSUPPORTED_MEDIA_TYPE",
    "429": "TOO_MANY_REQUESTS",
    "500": "INTERNAL_ERROR",
    "502": "UPSTREAM_UNAVAILABLE",
    "503": "UPSTREAM_UNAVAILABLE",
    "504": "UPSTREAM_TIMEOUT"
  },
  "scenarios": [
    { "id": "gateway.auth.missing", "origin": "gateway", "request": "보호 경로, Authorization 없음 또는 공백", "http": 401, "code": "AUTH_REQUIRED" },
    { "id": "gateway.auth.expired", "origin": "gateway", "request": "보호 경로, 서명은 맞고 만료된 Bearer", "http": 401, "code": "AUTH_EXPIRED" },
    { "id": "gateway.auth.invalid", "origin": "gateway", "request": "보호 경로, 위조 서명·Bearer 아님·Authorization 중복", "http": 401, "code": "AUTH_INVALID" },
    { "id": "gateway.path.invalid", "origin": "gateway", "request": "/api/core/../x, %2f, 끝 슬래시 등 정규화 거부 경로", "http": 400, "code": "INVALID_PATH" },
    { "id": "gateway.route.notFound", "origin": "gateway", "request": "어떤 라우트에도 맞지 않는 경로", "http": 404, "code": "NOT_FOUND" },
    { "id": "gateway.upstream.unavailable", "origin": "gateway", "request": "유효 토큰, 대상 서비스 연결 거부", "http": 503, "code": "UPSTREAM_UNAVAILABLE" },
    { "id": "core.auth.missing", "origin": "core", "request": "직접 포트 보호 경로, 토큰 없음", "http": 401, "code": "AUTH_REQUIRED" },
    { "id": "core.auth.expired", "origin": "core", "request": "직접 포트, 만료 토큰", "http": 401, "code": "AUTH_EXPIRED" },
    { "id": "core.auth.invalid", "origin": "core", "request": "직접 포트, 위조 토큰", "http": 401, "code": "AUTH_INVALID" },
    { "id": "core.validation", "origin": "core", "request": "@Valid 실패(로그인 빈 본문)", "http": 400, "code": "BAD_REQUEST" },
    { "id": "core.malformedJson", "origin": "core", "request": "깨진 JSON 본문", "http": 400, "code": "BAD_REQUEST" },
    { "id": "core.methodNotAllowed", "origin": "core", "request": "존재하는 경로에 허용되지 않은 메서드", "http": 405, "code": "METHOD_NOT_ALLOWED" },
    { "id": "core.route.notFound", "origin": "core", "request": "인증된 요청, 매핑 없는 경로", "http": 404, "code": "NOT_FOUND" },
    { "id": "core.forbidden", "origin": "core", "request": "ForbiddenException", "http": 403, "code": "FORBIDDEN" },
    { "id": "core.legacyNumeric", "origin": "core", "request": "컨트롤러가 ApiResponse.error(msg, \"401\")를 반환", "http": 401, "code": "AUTH_REQUIRED" },
    { "id": "core.payloadTooLarge", "origin": "core", "request": "multipart 한도 초과", "http": 413, "code": "PAYLOAD_TOO_LARGE" },
    { "id": "core.signup.duplicateEmail", "origin": "core", "request": "이미 가입된 이메일로 POST /api/core/auth/signup", "http": 409, "code": "DUPLICATE_EMAIL" },
    { "id": "core.signup.duplicateNickname", "origin": "core", "request": "이미 쓰는 닉네임으로 POST /api/core/auth/signup", "http": 409, "code": "DUPLICATE_NICKNAME" },
    { "id": "core.internal", "origin": "core", "request": "처리되지 않은 예외", "http": 500, "code": "INTERNAL_ERROR" },
    { "id": "assist.auth.missing", "origin": "assist", "request": "직접 포트, 토큰 없음", "http": 401, "code": "AUTH_REQUIRED" },
    { "id": "assist.auth.expired", "origin": "assist", "request": "직접 포트, 만료 토큰", "http": 401, "code": "AUTH_EXPIRED" },
    { "id": "assist.auth.invalid", "origin": "assist", "request": "직접 포트, 위조 토큰", "http": 401, "code": "AUTH_INVALID" },
    { "id": "assist.malformedJson", "origin": "assist", "request": "인증된 요청, 깨진 JSON 본문", "http": 400, "code": "BAD_REQUEST" },
    { "id": "assist.methodNotAllowed", "origin": "assist", "request": "인증된 요청, 허용되지 않은 메서드", "http": 405, "code": "METHOD_NOT_ALLOWED" },
    { "id": "assist.route.notFound", "origin": "assist", "request": "인증된 요청, 매핑 없는 경로", "http": 404, "code": "NOT_FOUND" },
    { "id": "assist.internal", "origin": "assist", "request": "처리되지 않은 예외", "http": 500, "code": "INTERNAL_ERROR" }
  ]
}
